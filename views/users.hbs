<div class="page-wrapper user-management-page">
  <!-- Page Header -->
  <div class="page-header-modern">
    <div class="page-header-content">
      <div class="page-header-left">
        <span class="page-eyebrow">Administration</span>
        <h1 class="page-heading">User Management</h1>
        <p class="page-description">Manage system users, assign roles, and control account access</p>
      </div>
      <div class="page-header-right">
        <button class="btn btn-primary" id="openAddUserModal">
          <i class="fas fa-plus"></i>
          Add New User
        </button>
      </div>
    </div>
  </div>

  <!-- Alerts -->
  {{#if successMessage}}
  <div class="alert alert-success alert-dismissible">
    <i class="fas fa-check-circle"></i>
    <span>{{successMessage}}</span>
    <button class="alert-close" onclick="this.parentElement.remove()">
      <i class="fas fa-times"></i>
    </button>
  </div>
  {{/if}}

  {{#if errorMessage}}
  <div class="alert alert-error alert-dismissible">
    <i class="fas fa-exclamation-circle"></i>
    <span>{{errorMessage}}</span>
    <button class="alert-close" onclick="this.parentElement.remove()">
      <i class="fas fa-times"></i>
    </button>
  </div>
  {{/if}}

  <!-- Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card-icon total">
        <i class="fas fa-users"></i>
      </div>
      <div class="stat-card-content">
        <span class="stat-card-value">{{stats.totalUsers}}</span>
        <span class="stat-card-label">Total Users</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-icon active">
        <i class="fas fa-user-check"></i>
      </div>
      <div class="stat-card-content">
        <span class="stat-card-value">{{stats.activeUsers}}</span>
        <span class="stat-card-label">Active Users</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-icon admin">
        <i class="fas fa-user-shield"></i>
      </div>
      <div class="stat-card-content">
        <span class="stat-card-value">{{stats.adminUsers}}</span>
        <span class="stat-card-label">Admins</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-icon technician">
        <i class="fas fa-user-cog"></i>
      </div>
      <div class="stat-card-content">
        <span class="stat-card-value">{{stats.technicianUsers}}</span>
        <span class="stat-card-label">Technicians</span>
      </div>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="data-card users-table-card">
    <div class="data-card-header">
      <div class="data-card-header-left">
        <div class="users-title-row">
          <span class="section-icon" aria-hidden="true">
            <i class="fas fa-list"></i>
          </span>

          <div class="users-title-text">
            <h3 class="data-card-title">All Users</h3>
            <span class="data-card-count">{{pagination.totalFilteredUsers}} users</span>
          </div>
        </div>
      </div>

      <div class="data-card-header-right">
        <form method="GET" action="/users" class="users-toolbar-form">
          <input type="hidden" name="role" value="{{filters.role}}">
          <input type="hidden" name="status" value="{{filters.status}}">

          <div class="search-box">
            <i class="fas fa-search"></i>
            <input
              type="text"
              id="userSearch"
              name="q"
              placeholder="Search users..."
              value="{{filters.q}}"
            >
          </div>
        </form>

        <details class="filter-dropdown" id="userFilterDropdown">
          <summary class="btn btn-outline btn-sm filter-trigger-btn">
            <span class="filter-summary-left">
              <i class="fas fa-sliders-h"></i>
              <span>Filter</span>
              <span class="filter-active-count" id="userFilterActiveCount" hidden>0</span>
            </span>
            <i class="fas fa-chevron-down filter-summary-arrow"></i>
          </summary>

          <div class="filter-panel compact-filter-panel">
            <div class="filter-panel-header">
              <h4>Filters</h4>
              <a href="/users?q={{filters.q}}&status=all&role=all" class="filter-clear-link">
                Clear All
              </a>
            </div>

            <form method="GET" action="/users" class="filter-form" id="usersFilterForm">
              <input type="hidden" name="q" value="{{filters.q}}">

              <details class="filter-section">
                <summary class="filter-section-toggle">
                  <span class="filter-section-left">
                    <i class="fas fa-toggle-on"></i>
                    <span id="statusFilterLabel">
                      {{#if (eq filters.status "active")}}Active
                      {{else if (eq filters.status "disabled")}}Disabled
                      {{else}}All Statuses
                      {{/if}}
                    </span>
                  </span>
                  <i class="fas fa-chevron-down"></i>
                </summary>

                <div class="filter-section-body">
                  <label class="filter-radio-option">
                    <input type="radio" name="status" value="all" {{#if (eq filters.status "all")}}checked{{/if}}>
                    <span>All Statuses</span>
                  </label>

                  <label class="filter-radio-option">
                    <input type="radio" name="status" value="active" {{#if (eq filters.status "active")}}checked{{/if}}>
                    <span>Active</span>
                  </label>

                  <label class="filter-radio-option">
                    <input type="radio" name="status" value="disabled" {{#if (eq filters.status "disabled")}}checked{{/if}}>
                    <span>Disabled</span>
                  </label>
                </div>
              </details>

              <details class="filter-section">
                <summary class="filter-section-toggle">
                  <span class="filter-section-left">
                    <i class="fas fa-user-tag"></i>
                    <span id="roleFilterLabel">
                      {{#if (eq filters.role "Admin")}}Admin
                      {{else if (eq filters.role "Technician")}}Technician
                      {{else}}All Roles
                      {{/if}}
                    </span>
                  </span>
                  <i class="fas fa-chevron-down"></i>
                </summary>

                <div class="filter-section-body">
                  <label class="filter-radio-option">
                    <input type="radio" name="role" value="all" {{#if (eq filters.role "all")}}checked{{/if}}>
                    <span>All Roles</span>
                  </label>

                  <label class="filter-radio-option">
                    <input type="radio" name="role" value="Admin" {{#if (eq filters.role "Admin")}}checked{{/if}}>
                    <span>Admin</span>
                  </label>

                  <label class="filter-radio-option">
                    <input type="radio" name="role" value="Technician" {{#if (eq filters.role "Technician")}}checked{{/if}}>
                    <span>Technician</span>
                  </label>
                </div>
              </details>

              <div class="filter-panel-footer filter-panel-actions">
                <button type="submit" class="btn btn-primary btn-sm">Apply</button>
              </div>
            </form>
          </div>
        </details>
      </div>
    </div>

    <div class="table-wrapper">
      <table class="data-table" id="usersTable">
        <thead>
          <tr>
            <th class="table-col-user">User</th>
            <th class="table-col-role">Role</th>
            <th class="table-col-status">Status</th>
            <th class="table-col-date">Created</th>
            <th class="table-col-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
          <tr>
            <td class="table-cell-user">
              <div class="user-cell">
                <div class="user-cell-avatar">
                  {{firstChar name}}
                </div>
                <div class="user-cell-info">
                  <span class="user-cell-name">{{name}}</span>
                  <span class="user-cell-email">{{email}}</span>
                </div>
              </div>
            </td>
            <td class="table-cell-role">
              <form
                action="/api/users/{{_id}}/role?_method=PATCH"
                method="POST"
                class="role-form"
                data-user-name="{{name}}"
              >
                <input type="hidden" name="_method" value="PATCH">
                <select
                  name="role"
                  class="role-select"
                  data-current-role="{{role}}"
                  onchange="handleRoleChange(this)"
                >
                  <option value="Admin" {{#if (eq role 'Admin')}}selected{{/if}}>Admin</option>
                  <option value="Technician" {{#if (eq role 'Technician')}}selected{{/if}}>Technician</option>
                </select>
              </form>
            </td>
            <td class="table-cell-status">
              <form
                action="/api/users/{{_id}}/status?_method=PATCH"
                method="POST"
                class="status-form"
                data-confirm-message="Are you sure you want to change this user's account status?"
              >
                <input type="hidden" name="_method" value="PATCH">
                <label class="status-toggle">
                  <input
                    type="checkbox"
                    name="isEnabled"
                    value="true"
                    {{#if isEnabled}}checked{{/if}}
                    data-current-checked="{{#if isEnabled}}true{{else}}false{{/if}}"
                    onchange="handleStatusToggleChange(this)"
                  >
                  <span class="status-toggle-slider"></span>
                  <span class="status-toggle-label {{#unless isEnabled}}disabled{{/unless}}">{{#if isEnabled}}Active{{else}}Disabled{{/if}}</span>
                </label>
              </form>
            </td>
            <td class="table-cell-date">
              <span class="date-cell">{{createdAtLabel}}</span>
            </td>
            <td class="table-cell-actions">
              <div class="action-buttons">
                <button
                  type="button"
                  class="action-btn-icon"
                  title="View Details"
                  data-user-name="{{name}}"
                  data-user-email="{{email}}"
                  data-user-role="{{role}}"
                  data-user-status="{{#if isEnabled}}Active{{else}}Disabled{{/if}}"
                  data-user-created="{{createdAtLabel}}"
                  onclick="openUserDetails(this)"
                >
                  <i class="fas fa-eye"></i>
                </button>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="table-empty">
              <div class="empty-state">
                <div class="empty-state-icon">
                  <i class="fas fa-users"></i>
                </div>
                <h4>No users found</h4>
                <p>Get started by adding your first user</p>
                <button class="btn btn-primary" id="openAddUserModalEmpty">
                  <i class="fas fa-plus"></i>
                  Add User
                </button>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="data-card-footer">
      <div class="pagination-info">
        Showing
        <strong>{{pagination.startIndex}}</strong>
        to
        <strong>{{pagination.endIndex}}</strong>
        of
        <strong>{{pagination.totalFilteredUsers}}</strong>
        users
      </div>

      <div class="pagination-controls">
        {{#if pagination.hasPrevPage}}
          <a
            class="btn btn-outline btn-sm"
            href="/users?page={{pagination.prevPage}}&q={{filters.q}}&status={{filters.status}}&role={{filters.role}}"
          >
            <i class="fas fa-chevron-left"></i>
            Previous
          </a>
        {{else}}
          <button class="btn btn-outline btn-sm" disabled>
            <i class="fas fa-chevron-left"></i>
            Previous
          </button>
        {{/if}}

        <span class="pagination-page-label">
          Page {{pagination.currentPage}} of {{pagination.totalPages}}
        </span>

        {{#if pagination.hasNextPage}}
          <a
            class="btn btn-outline btn-sm"
            href="/users?page={{pagination.nextPage}}&q={{filters.q}}&status={{filters.status}}&role={{filters.role}}"
          >
            Next
            <i class="fas fa-chevron-right"></i>
          </a>
        {{else}}
          <button class="btn btn-outline btn-sm" disabled>
            Next
            <i class="fas fa-chevron-right"></i>
          </button>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- Add User Modal -->
<div class="modal" id="addUserModal">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <div class="modal-header">
      <h3 class="modal-title">
        <i class="fas fa-user-plus"></i>
        Add New User
      </h3>
      <button class="modal-close" id="closeAddUserModal">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <form action="/api/users" method="POST" class="modal-form" id="addUserForm">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-input {{#if errors.name}}input-error{{/if}}" placeholder="Enter full name" value="{{formValues.name}}" required>
            {{#if errors.name}}
            <span class="form-error">{{errors.name}}</span>
            {{/if}}
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-input {{#if errors.email}}input-error{{/if}}" placeholder="Enter email address" value="{{formValues.email}}" required>
            {{#if errors.email}}
            <span class="form-error">{{errors.email}}</span>
            {{/if}}
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-input {{#if errors.password}}input-error{{/if}}" placeholder="Minimum 6 characters" required>
            {{#if errors.password}}
            <span class="form-error">{{errors.password}}</span>
            {{/if}}
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Role</label>
            <select name="role" class="form-select">
              <option value="Technician" {{#if (eq formValues.role 'Technician')}}selected{{/if}}>Technician</option>
              <option value="Admin" {{#if (eq formValues.role 'Admin')}}selected{{/if}}>Admin</option>
            </select>
          </div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" id="cancelAddUser">Cancel</button>
      <button type="submit" form="addUserForm" class="btn btn-primary">
        <i class="fas fa-plus"></i>
        Create User
      </button>
    </div>
  </div>
</div>

<div class="modal" id="userDetailsModal">
  <div class="modal-overlay"></div>
  <div class="modal-container modal-sm">
    <div class="modal-header">
      <h3 class="modal-title">
        <i class="fas fa-user"></i>
        User Details
      </h3>
      <button class="modal-close" id="closeUserDetailsModal">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input type="text" class="form-input detail-readonly-input" id="detailUserName" readonly>
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="text" class="form-input detail-readonly-input" id="detailUserEmail" readonly>
      </div>
      <div class="form-group">
        <label class="form-label">Role</label>
        <input type="text" class="form-input detail-readonly-input" id="detailUserRole" readonly>
      </div>
      <div class="form-group">
        <label class="form-label">Status</label>
        <input type="text" class="form-input detail-readonly-input" id="detailUserStatus" readonly>
      </div>
      <div class="form-group">
        <label class="form-label">Created</label>
        <input type="text" class="form-input detail-readonly-input" id="detailUserCreated" readonly>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('addUserModal');
  const openBtn = document.getElementById('openAddUserModal');
  const openBtnEmpty = document.getElementById('openAddUserModalEmpty');
  const closeBtn = document.getElementById('closeAddUserModal');
  const cancelBtn = document.getElementById('cancelAddUser');
  const overlay = modal.querySelector('.modal-overlay');
  
  function openModal() {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (openBtnEmpty) openBtnEmpty.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
  if (overlay) overlay.addEventListener('click', closeModal);

  const userSearch = document.getElementById('userSearch');
  const usersToolbarForm = document.querySelector('.users-toolbar-form');
  const usersFilterForm = document.getElementById('usersFilterForm');
  const userFilterDropdown = document.getElementById('userFilterDropdown');
  const filterActiveCount = document.getElementById('userFilterActiveCount');
  const filterClearLink = document.querySelector('.filter-clear-link');
  const statusFilterLabel = document.getElementById('statusFilterLabel');
  const roleFilterLabel = document.getElementById('roleFilterLabel');
  let pendingRoleChange = null;

  function selectedRadioValue(form, name) {
    const checked = form?.querySelector(`input[name="${name}"]:checked`);
    return checked ? checked.value : 'all';
  }

  function statusDisplayText(status) {
    if (status === 'active') return 'Active';
    if (status === 'disabled') return 'Disabled';
    return 'All Statuses';
  }

  function roleDisplayText(role) {
    if (role === 'Admin') return 'Admin';
    if (role === 'Technician') return 'Technician';
    return 'All Roles';
  }

  function updateFilterSummary() {
    if (!usersFilterForm) return;

    const status = selectedRadioValue(usersFilterForm, 'status');
    const role = selectedRadioValue(usersFilterForm, 'role');

    if (statusFilterLabel) {
      statusFilterLabel.textContent = statusDisplayText(status);
    }

    if (roleFilterLabel) {
      roleFilterLabel.textContent = roleDisplayText(role);
    }

    let activeCount = 0;
    if (status !== 'all') activeCount += 1;
    if (role !== 'all') activeCount += 1;

    if (filterActiveCount) {
      filterActiveCount.textContent = String(activeCount);
      filterActiveCount.hidden = activeCount === 0;
    }

    const triggerBtn = userFilterDropdown?.querySelector('.filter-trigger-btn');
    if (triggerBtn) {
      triggerBtn.classList.toggle('has-active-filters', activeCount > 0);
    }
  }

  if (usersFilterForm) {
    usersFilterForm.addEventListener('change', updateFilterSummary);

    usersFilterForm.addEventListener('submit', function () {
      const queryInput = this.querySelector('input[name="q"]');
      if (queryInput && userSearch) {
        queryInput.value = userSearch.value.trim();
      }
    });
  }

  if (filterClearLink) {
    filterClearLink.addEventListener('click', function (event) {
      event.preventDefault();
      const searchQuery = userSearch ? encodeURIComponent(userSearch.value.trim()) : '';
      window.location.href = `/users?q=${searchQuery}&status=all&role=all`;
    });
  }

  if (userSearch && usersToolbarForm) {
    let searchDebounceTimer = null;

    userSearch.addEventListener('input', function () {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        usersToolbarForm.submit();
      }, 400);
    });
  }

  updateFilterSummary();

  window.handleRoleChange = function (select) {
    const form = select?.form;
    if (!form) return;

    const previousRole = select.dataset.currentRole || '';
    const nextRole = select.value;

    if (!previousRole || previousRole === nextRole) {
      return;
    }

    const userName = form.dataset.userName || 'this user';
    const message = `Change ${userName}'s role from ${previousRole} to ${nextRole}?`;

    pendingRoleChange = {
      select,
      previousRole,
      nextRole,
      confirmed: false,
    };

    form.setAttribute('data-confirm-message', message);

    const sharedConfirmModal = document.getElementById('confirmModal');
    const sharedConfirmAcceptBtn = document.getElementById('acceptConfirmModal');

    if (sharedConfirmModal && sharedConfirmAcceptBtn) {
      const cleanup = () => {
        sharedConfirmAcceptBtn.removeEventListener('click', handleConfirmAccept);
        confirmModalObserver.disconnect();
      };

      const handleConfirmAccept = () => {
        if (!pendingRoleChange || pendingRoleChange.select !== select) return;

        pendingRoleChange.confirmed = true;
        select.dataset.currentRole = nextRole;
      };

      const confirmModalObserver = new MutationObserver(() => {
        const isOpen = sharedConfirmModal.classList.contains('active');

        if (isOpen) return;

        if (
          pendingRoleChange &&
          pendingRoleChange.select === select &&
          !pendingRoleChange.confirmed
        ) {
          select.value = previousRole;
          select.dataset.currentRole = previousRole;
        }

        if (pendingRoleChange && pendingRoleChange.select === select) {
          pendingRoleChange = null;
        }

        cleanup();
      });

      sharedConfirmAcceptBtn.addEventListener('click', handleConfirmAccept);
      confirmModalObserver.observe(sharedConfirmModal, {
        attributes: true,
        attributeFilter: ['class'],
      });
    }

    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit();
      return;
    }

    const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
    const shouldContinue = form.dispatchEvent(submitEvent);
    if (shouldContinue) {
      form.submit();
    }
  };

  const userDetailsModal = document.getElementById('userDetailsModal');
  const closeUserDetailsModalBtn = document.getElementById('closeUserDetailsModal');
  const userDetailsOverlay = userDetailsModal?.querySelector('.modal-overlay');

  function openUserDetails(button) {
    document.getElementById('detailUserName').value = button.dataset.userName || '-';
    document.getElementById('detailUserEmail').value = button.dataset.userEmail || '-';
    document.getElementById('detailUserRole').value = button.dataset.userRole || '-';
    document.getElementById('detailUserStatus').value = button.dataset.userStatus || '-';
    document.getElementById('detailUserCreated').value = button.dataset.userCreated || '-';

    userDetailsModal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeUserDetails() {
    userDetailsModal.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (closeUserDetailsModalBtn) closeUserDetailsModalBtn.addEventListener('click', closeUserDetails);
  if (userDetailsOverlay) userDetailsOverlay.addEventListener('click', closeUserDetails);
  
</script>