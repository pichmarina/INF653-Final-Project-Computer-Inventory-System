<section class="login-shell">
  <div class="login-hero">
    <div class="login-hero-content">
      <div class="eyebrow">American University of Phnom Penh</div>
      <h1>IT Asset<br /><span>Management System</span></h1>
      <p>
        Track hardware, control access, manage API integrations,
        and keep your IT operations organized — all in one secure workspace.
      </p>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong>Secured</strong>
          <span>JWT + RBAC + bcrypt</span>
        </div>
        <div class="hero-stat">
          <strong>Auditable</strong>
          <span>Full asset history</span>
        </div>
        <div class="hero-stat">
          <strong>Integrated</strong>
          <span>API key access</span>
        </div>
      </div>
    </div>
  </div>

  <div class="login-panel">
    <div class="login-panel-inner">
      <div class="auth-header">
        <div class="eyebrow">INF 653 — Final Project</div>
        <h2>Sign In</h2>
        <p>Use your IT department credentials to access the system.</p>
      </div>

      {{#if formError}}
        <div class="alert alert-error" style="margin-bottom:18px;">{{formError}}</div>
      {{/if}}

      <form action="/api/auth/login" method="POST" class="form">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            id="email" name="email" type="email"
            placeholder="admin@aupp.edu.kh"
            value="{{values.email}}"
            class="{{#if errors.email}}input-error{{/if}}"
            autocomplete="email"
          />
          {{#if errors.email}}<small class="field-error">{{errors.email}}</small>{{/if}}
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            id="password" name="password" type="password"
            placeholder="Enter your password"
            class="{{#if errors.password}}input-error{{/if}}"
            autocomplete="current-password"
          />
          {{#if errors.password}}<small class="field-error">{{errors.password}}</small>{{/if}}
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top:4px;">
          Sign In →
        </button>
      </form>

      <p style="margin-top:20px; font-size:0.75rem; color:var(--text-3); text-align:center;">
        Access restricted to authorized AUPP IT personnel only.
      </p>
    </div>
  </div>
</section>
