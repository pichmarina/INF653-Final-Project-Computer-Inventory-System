<section class="page-stack">
  <div class="page-header">
    <div>
      <div class="eyebrow">Admin Workspace</div>
      <h1>User Management</h1>
      <p>
        Create and manage Admin and Technician accounts for the computer inventory system.
      </p>
    </div>
    <span class="panel-chip">Admin Only</span>
  </div>

  {{#if successMessage}}
    <div class="alert alert-success">{{successMessage}}</div>
  {{/if}}

  {{#if errorMessage}}
    <div class="alert alert-error">{{errorMessage}}</div>
  {{/if}}

  <div class="metric-grid">
    <div class="metric-card">
      <span class="metric-label">Total Users</span>
      <strong>{{stats.totalUsers}}</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Active Accounts</span>
      <strong>{{stats.activeUsers}}</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Admins</span>
      <strong>{{stats.adminUsers}}</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Technicians</span>
      <strong>{{stats.technicianUsers}}</strong>
    </div>
  </div>

  <div class="admin-grid">
    <div class="surface-card">
      <div class="card-head">
        <div>
          <h2>Create New User</h2>
          <p>Add internal users with the correct role and protected password storage.</p>
        </div>
        <span class="soft-badge">bcrypt protected</span>
      </div>

      <form action="/api/users" method="POST" class="form">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="e.g. Lina Chan"
            value="{{formValues.name}}"
            class="{{#if errors.name}}input-error{{/if}}"
          />
          {{#if errors.name}}<small class="field-error">{{errors.name}}</small>{{/if}}
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="user@aupp.edu.kh"
            value="{{formValues.email}}"
            class="{{#if errors.email}}input-error{{/if}}"
          />
          {{#if errors.email}}<small class="field-error">{{errors.email}}</small>{{/if}}
        </div>

        <div class="form-group">
          <label for="password">Temporary Password</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Minimum 6 characters"
            class="{{#if errors.password}}input-error{{/if}}"
          />
          {{#if errors.password}}<small class="field-error">{{errors.password}}</small>{{/if}}
        </div>

        <div class="form-group">
          <label for="role">Role</label>
          <select id="role" name="role" class="{{#if errors.role}}input-error{{/if}}">
            <option value="">Select role</option>
            <option value="Admin" {{#if (eq formValues.role "Admin")}}selected{{/if}}>Admin</option>
            <option value="Technician" {{#if (eq formValues.role "Technician")}}selected{{/if}}>Technician</option>
          </select>
          {{#if errors.role}}<small class="field-error">{{errors.role}}</small>{{/if}}
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create User</button>
      </form>
    </div>

    <div class="surface-card">
      <div class="card-head">
        <div>
          <h2>Existing Users</h2>
          <p>Update roles, disable accounts, and keep admin access under control.</p>
        </div>
        <span class="soft-badge">{{stats.totalUsers}} records</span>
      </div>

      <div class="entity-list">
        {{#each users}}
          <div class="entity-card">
            <div class="entity-main">
              <div>
                <h3>{{this.name}}</h3>
                <p>{{this.email}}</p>
              </div>

              <div class="entity-badges">
                {{#if (eq this.role "Admin")}}
                  <span class="badge badge-admin">Admin</span>
                {{else}}
                  <span class="badge badge-info">Technician</span>
                {{/if}}

                {{#if this.isEnabled}}
                  <span class="badge badge-success">Enabled</span>
                {{else}}
                  <span class="badge badge-danger">Disabled</span>
                {{/if}}
              </div>
            </div>

            <div class="entity-meta">
              <span class="meta-pill">Created {{this.createdAtLabel}}</span>
              <span class="meta-pill">User ID {{this._id}}</span>
            </div>

            <div class="entity-actions">
              <form action="/api/users/{{this._id}}/role?_method=PATCH" method="POST" class="inline-form">
                <select name="role">
                  <option value="Admin" {{#if (eq this.role "Admin")}}selected{{/if}}>Admin</option>
                  <option value="Technician" {{#if (eq this.role "Technician")}}selected{{/if}}>Technician</option>
                </select>
                <button type="submit" class="btn btn-outline btn-sm">Update Role</button>
              </form>

              <form action="/api/users/{{this._id}}/status?_method=PATCH" method="POST" class="inline-form">
                {{#if this.isEnabled}}
                  <input type="hidden" name="isEnabled" value="false" />
                  <button
                    type="submit"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Disable this user account? This will also revoke their active API keys.')"
                  >
                    Disable
                  </button>
                {{else}}
                  <input type="hidden" name="isEnabled" value="true" />
                  <button type="submit" class="btn btn-primary btn-sm">
                    Enable
                  </button>
                {{/if}}
              </form>
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <h3>No users found</h3>
            <p>Create the first Admin or Technician account to begin managing access.</p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>