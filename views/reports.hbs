<div class="page-wrapper">
  <div class="page-header-modern">
    <div class="page-header-content">
      <div class="page-header-left">
        <span class="page-eyebrow">Analytics</span>
        <h1 class="page-heading">Reports</h1>
        <p class="page-description">Generate insights and analytics about your inventory</p>
      </div>
    </div>
  </div>

  <!-- Accordion Sections -->
  <div class="report-accordion">

    <!-- Inventory Summary -->
    <div class="report-section" id="section-summary">
      <button class="report-toggle-btn" type="button" aria-expanded="true" data-target="body-summary">
        <span class="report-section-title">
          <i class="fas fa-chart-pie"></i>
          Inventory Summary
        </span>
        <i class="fas fa-chevron-down report-chevron"></i>
      </button>
      <div class="report-section-body" id="body-summary">
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Metric</th>
                <th>Count</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Total Items</td><td>{{summary.total}}</td></tr>
              <tr><td>Deployed (In Use)</td><td>{{summary.deployed}}</td></tr>
              <tr><td>Available</td><td>{{summary.available}}</td></tr>
              <tr><td>Maintenance</td><td>{{summary.maintenance}}</td></tr>
              <tr><td>Retired</td><td>{{summary.retired}}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="report-section-footer">
          <a href="/reports/export/summary" class="btn btn-outline">
            <i class="fas fa-download"></i> Download CSV
          </a>
        </div>
      </div>
    </div>

    <!-- Asset Aging -->
    <div class="report-section" id="section-aging">
      <button class="report-toggle-btn" type="button" aria-expanded="true" data-target="body-aging">
        <span class="report-section-title">
          <i class="fas fa-clock"></i>
          Asset Aging
          <span class="report-section-badge">Items older than 3 years</span>
        </span>
        <i class="fas fa-chevron-down report-chevron"></i>
      </button>
      <div class="report-section-body" id="body-aging">
        {{#if agingItems.length}}
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Asset</th>
                  <th>Item ID</th>
                  <th>Serial Number</th>
                  <th>Age</th>
                  <th>Date Acquired</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {{#each agingItems}}
                  <tr>
                    <td>{{this.displayName}}</td>
                    <td><span class="inv2-code">{{this.itemId}}</span></td>
                    <td><span class="inv2-code">{{this.serialNumber}}</span></td>
                    <td><span class="asset-age-pill">{{this.ageLabel}}</span></td>
                    <td>{{formatDate this.dateAcquired}}</td>
                    <td>{{this.status}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <p class="report-empty">No items older than 3 years.</p>
        {{/if}}
        <div class="report-section-footer">
          <a href="/reports/export/aging" class="btn btn-outline">
            <i class="fas fa-download"></i> Download CSV
          </a>
        </div>
      </div>
    </div>

    <!-- Assets by User -->
    <div class="report-section" id="section-byuser">
      <button class="report-toggle-btn" type="button" aria-expanded="true" data-target="body-byuser">
        <span class="report-section-title">
          <i class="fas fa-user-tag"></i>
          Assets by User
        </span>
        <i class="fas fa-chevron-down report-chevron"></i>
      </button>
      <div class="report-section-body" id="body-byuser">
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>User</th>
                <th>Email</th>
                <th>Assigned Items</th>
              </tr>
            </thead>
            <tbody>
              {{#each assetsByUser}}
                <tr>
                  <td>{{this.user.name}}</td>
                  <td>{{this.user.email}}</td>
                  <td>
                    {{#if this.items.length}}
                      <ul class="report-items-list">
                        {{#each this.items}}
                          <li>
                            <strong>{{this.displayName}}</strong>
                            <span>{{this.itemId}} · {{this.status}}</span>
                          </li>
                        {{/each}}
                      </ul>
                    {{else}}
                      <span style="color:var(--text-muted);">No assets assigned</span>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <div class="report-section-footer">
          <a href="/reports/export/by-user" class="btn btn-outline">
            <i class="fas fa-download"></i> Download CSV
          </a>
        </div>
      </div>
    </div>

  </div><!-- end .report-accordion -->
</div><!-- end .page-wrapper -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.report-toggle-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var bodyId = btn.getAttribute('data-target');
        var body = document.getElementById(bodyId);
        if (!body) return;

        if (expanded) {
          body.style.maxHeight = body.scrollHeight + 'px';
          requestAnimationFrame(function () {
            body.style.maxHeight = '0';
          });
          btn.setAttribute('aria-expanded', 'false');
          btn.classList.add('collapsed');
        } else {
          body.style.maxHeight = body.scrollHeight + 'px';
          body.addEventListener('transitionend', function handler() {
            body.style.maxHeight = 'none';
            body.removeEventListener('transitionend', handler);
          });
          btn.setAttribute('aria-expanded', 'true');
          btn.classList.remove('collapsed');
        }
      });
    });
  });
</script>
