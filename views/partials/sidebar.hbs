<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="brand">
      <div class="brand-icon">
        <i class="fas fa-server"></i>
      </div>
      <div class="brand-text">
        <span class="brand-title">CIS</span>
        <span class="brand-subtitle">Inventory System</span>
      </div>
    </div>
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <i class="fas fa-chevron-left"></i>
    </button>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-section-title">Main</span>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/dashboard" class="nav-link {{#if (eq currentPath '/dashboard')}}active{{/if}}">
            <span class="nav-icon"><i class="fas fa-th-large"></i></span>
            <span class="nav-text">Dashboard</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/inventory" class="nav-link {{#if (eq currentPath '/inventory')}}active{{/if}}">
            <span class="nav-icon"><i class="fas fa-boxes"></i></span>
            <span class="nav-text">Inventory</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/transactions" class="nav-link {{#if (eq currentPath '/transactions')}}active{{/if}}">
            <span class="nav-icon"><i class="fas fa-exchange-alt"></i></span>
            <span class="nav-text">Check-In/Out</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/history" class="nav-link {{#if (eq currentPath '/history')}}active{{/if}}">
            <span class="nav-icon"><i class="fas fa-history"></i></span>
            <span class="nav-text">History</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="nav-section">
      <span class="nav-section-title">Analytics</span>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/reports" class="nav-link {{#if (eq currentPath '/reports')}}active{{/if}}">
            <span class="nav-icon"><i class="fas fa-chart-bar"></i></span>
            <span class="nav-text">Reports</span>
          </a>
        </li>
      </ul>
    </div>

    {{!-- Administration section - always show for now to test --}}
    {{#if (isAdmin user)}}
      <div class="nav-section">
        <span class="nav-section-title">Administration</span>
        <ul class="nav-list">
          <li class="nav-item">
            <a href="/users" class="nav-link {{#if (eq currentPath '/users')}}active{{/if}}">
              <span class="nav-icon"><i class="fas fa-users-cog"></i></span>
              <span class="nav-text">User Management</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/keys" class="nav-link {{#if (eq currentPath '/keys')}}active{{/if}}">
              <span class="nav-icon"><i class="fas fa-key"></i></span>
              <span class="nav-text">API Keys</span>
            </a>
          </li>
        </ul>
      </div>
    {{/if}}
  </nav>

  <div class="sidebar-footer">
    <button
      type="button"
      class="user-card user-card-trigger {{#if (eq currentPath '/profile')}}active{{/if}}"
      id="profileCardTrigger"
      aria-label="Open account menu"
      aria-expanded="false"
      aria-controls="profilePopover"
    >
      <div class="user-avatar">
        {{#if user.avatarPath}}
          <img src="{{user.avatarPath}}" alt="{{user.name}}" class="user-avatar-image">
        {{else}}
          {{#if user.name}}
            {{firstChar user.name}}
          {{else}}
            <i class="fas fa-user"></i>
          {{/if}}
        {{/if}}
      </div>
      <div class="user-info">
        <span class="user-name">{{user.name}}</span>
        <span class="user-role">
          <span class="role-badge role-{{toLowerCase user.role}}">{{user.role}}</span>
        </span>
      </div>
    </button>

    <div class="profile-popover" id="profilePopover" hidden>
      <div class="profile-popover-header">
        <div class="user-avatar profile-popover-avatar">
          {{#if user.avatarPath}}
            <img src="{{user.avatarPath}}" alt="{{user.name}}" class="user-avatar-image">
          {{else}}
            {{#if user.name}}
              {{firstChar user.name}}
            {{else}}
              <i class="fas fa-user"></i>
            {{/if}}
          {{/if}}
        </div>
        <div class="profile-popover-info">
          <span class="profile-popover-name">{{user.name}}</span>
          <span class="profile-popover-email">{{user.email}}</span>
        </div>
      </div>
      <div class="profile-popover-actions">
        <a href="/profile" class="btn btn-outline btn-sm profile-popover-link">
          <i class="fas fa-user-circle"></i>
          View Profile
        </a>
        <form
          action="/api/auth/logout"
          method="POST"
          class="profile-popover-logout-form"
          data-confirm-message="Are you sure you want to log out?"
        >
          <button type="submit" class="btn btn-outline btn-sm profile-popover-logout-btn">
            <i class="fas fa-sign-out-alt"></i>
            Sign Out
          </button>
        </form>
      </div>
    </div>

    <form
      action="/api/auth/logout"
      method="POST"
      class="logout-form"
      data-confirm-message="Are you sure you want to log out?"
    >
      <button type="submit" class="logout-btn" title="Logout">
        <i class="fas fa-sign-out-alt"></i>
        <span class="logout-text">Logout</span>
      </button>
    </form>
  </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>