<section class="card">
  <h1>Item Details</h1>
  <p>Detailed information for the selected inventory item.</p>

  <div class="grid">
    <div class="mini-card">
      <strong>Item ID</strong>
      <p>{{itemId}}</p>
    </div>
    <div class="mini-card">
      <strong>Brand</strong>
      <p>Dell</p>
    </div>
    <div class="mini-card">
      <strong>Model</strong>
      <p>Latitude 5420</p>
    </div>
    <div class="mini-card">
      <strong>Category</strong>
      <p>Laptop</p>
    </div>
    <div class="mini-card">
      <strong>Status</strong>
      <p>Available</p>
    </div>
    <div class="mini-card">
      <strong>Assigned To</strong>
      <p>—</p>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <a href="/items/{{itemId}}/edit" class="btn" style="text-decoration: none; display: inline-block;">Edit Item</a>
  </div>

  <form method="POST" action="/api/items/{{itemId}}?_method=DELETE" style="margin-top: 12px;">
    <button type="submit" class="btn">Delete Item</button>
  </form>