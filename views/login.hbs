<section class="auth-shell">
  <div class="auth-aside">
    <div class="auth-aside-inner">
      <div class="eyebrow">AUPP · INF 653 Final Project</div>
      <h1>Secure access for your computer inventory workspace</h1>
      <p class="auth-lead">
        Manage users, roles, and API integrations in a cleaner internal system designed for IT operations.
      </p>

      <div class="auth-feature-list">
        <div class="auth-feature">
          <span class="feature-dot"></span>
          <div>
            <strong>JWT protected access</strong>
            <p>Only authenticated users can reach protected routes and admin pages.</p>
          </div>
        </div>

        <div class="auth-feature">
          <span class="feature-dot"></span>
          <div>
            <strong>Role-based control</strong>
            <p>Admins can create users, assign roles, and block unauthorized access.</p>
          </div>
        </div>

        <div class="auth-feature">
          <span class="feature-dot"></span>
          <div>
            <strong>Secure API integration</strong>
            <p>Generate hashed API keys and revoke them instantly when needed.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="auth-panel">
    <div class="auth-card">
      <div class="auth-header">
        <div class="eyebrow">Sign In</div>
        <h2>Welcome back</h2>
        <p>Use your IT department account to continue.</p>
      </div>

      {{#if formError}}
        <div class="alert alert-error">{{formError}}</div>
      {{/if}}

      <form action="/api/auth/login" method="POST" class="form auth-form">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="admin@aupp.edu.kh"
            value="{{values.email}}"
            class="{{#if errors.email}}input-error{{/if}}"
            autocomplete="email"
          />
          {{#if errors.email}}<small class="field-error">{{errors.email}}</small>{{/if}}
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Enter your password"
            class="{{#if errors.password}}input-error{{/if}}"
            autocomplete="current-password"
          />
          {{#if errors.password}}<small class="field-error">{{errors.password}}</small>{{/if}}
        </div>

        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
      </form>

      <p class="auth-note">
        Access is restricted to authorized personnel only.
      </p>
    </div>
  </div>
</section>