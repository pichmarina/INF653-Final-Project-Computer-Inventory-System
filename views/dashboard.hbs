<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} | {{appName}}</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  {{> navbar}}

  <main class="container">
    <section class="card page-header-card">
      <h1>{{title}}</h1>
      <p>Overview of the Computer Inventory System and quick access to key sections.</p>

      <section class="stats-grid">
        <div class="mini-card stat-box">
          <h3>Total Users</h3>
          <p class="stat-number">{{stats.totalUsers}}</p>
        </div>

        <div class="mini-card stat-box">
          <h3>Total Items</h3>
          <p class="stat-number">{{stats.totalItems}}</p>
        </div>

        <div class="mini-card stat-box">
          <h3>Available Items</h3>
          <p class="stat-number">{{stats.availableItems}}</p>
        </div>

        <div class="mini-card stat-box">
          <h3>Deployed Items</h3>
          <p class="stat-number">{{stats.deployedItems}}</p>
        </div>
      </section>
    </section>

    <section class="card">
      <h2>Quick Access</h2>
      <div class="grid">
        {{#each quickLinks}}
        <a href="{{this.href}}" class="mini-card quick-link-card">
          <h3>{{this.title}}</h3>
          <p>{{this.description}}</p>
        </a>
        {{/each}}
      </div>
    </section>

    <section class="card">
      <h2>Recent Activity</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Item</th>
              <th>Action</th>
              <th>User</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentActivity}}
            <tr>
              <td>{{this.itemName}}</td>
              <td>{{this.action}}</td>
              <td>{{this.user}}</td>
              <td>{{this.date}}</td>
              <td><span class="status-badge">{{this.status}}</span></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  {{> footer}}
</body>

</html>