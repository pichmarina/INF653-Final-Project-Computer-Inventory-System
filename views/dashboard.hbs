<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} | {{appName}}</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  {{> navbar}}

  <main class="container">
    <section class="card">
      <h1>{{title}}</h1>
      <p>Starter dashboard page for the Computer Inventory System.</p>

      <div class="grid">
        <div class="mini-card">
          <h3>Users</h3>
          <p>Manage system users</p>
        </div>

        <div class="mini-card">
          <h3>Inventory</h3>
          <p>Manage items and status</p>
        </div>

        <div class="mini-card">
          <h3>Transactions</h3>
          <p>Track check-in and check-out</p>
        </div>

        <div class="mini-card">
          <h3>Reports</h3>
          <p>View inventory reports</p>
        </div>
      </div>
    </section>
  </main>

  {{> footer}}
</body>

</html>