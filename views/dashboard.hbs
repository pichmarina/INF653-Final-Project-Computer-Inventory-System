<section class="page-stack">
  <div class="page-header">
    <div>
      <div class="eyebrow">Overview</div>
      <h1>Welcome to the computer inventory system</h1>
      <p>
        A modern internal workspace for managing assets, access control, transactions, and reports.
      </p>
    </div>

    <div class="account-card">
      <div class="account-avatar">SA</div>

      <div class="account-info">
        <strong>{{displayName}}</strong>
        <span>{{displayRole}} · {{displayEmail}}</span>
      </div>

      <form action="/api/auth/logout" method="POST">
        <button type="submit" class="btn btn-outline btn-sm">Sign Out</button>
      </form>
    </div>
  </div>

  <div class="overview-grid">
    <a class="overview-card" href="/inventory">
      <div class="overview-icon">🖥️</div>
      <h3>Inventory</h3>
      <p>Manage computers and peripherals with item records, status, and lifecycle updates.</p>
    </a>

    <a class="overview-card" href="/transactions">
      <div class="overview-icon">📦</div>
      <h3>Transactions</h3>
      <p>Handle check-out and check-in flows with supporting documents.</p>
    </a>

    <a class="overview-card" href="/history">
      <div class="overview-icon">🕘</div>
      <h3>History</h3>
      <p>Review audit trails, previous assignees, and reference documents.</p>
    </a>

    <a class="overview-card" href="/users">
      <div class="overview-icon">👥</div>
      <h3>Users</h3>
      <p>Create accounts, assign roles, and manage account status.</p>
    </a>

    <a class="overview-card" href="/keys">
      <div class="overview-icon">🔑</div>
      <h3>API Keys</h3>
      <p>Generate integration credentials and revoke them instantly when needed.</p>
    </a>

    <a class="overview-card" href="/reports">
      <div class="overview-icon">📊</div>
      <h3>Reports</h3>
      <p>Review inventory summary, aging assets, and user-based audit data.</p>
    </a>
  </div>
</section>