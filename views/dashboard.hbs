<div class="page-wrapper">
  <!-- Welcome Section -->
  <div class="welcome-section">
    <div class="welcome-content">
      <div class="welcome-avatar">
        {{#if user.avatarPath}}
          <img src="{{user.avatarPath}}" alt="{{displayName}}" class="welcome-avatar-image">
        {{else}}
          {{firstChar displayName}}
        {{/if}}
      </div>
      <div class="welcome-text">
        <h1 class="welcome-title">Welcome back, {{displayName}}!</h1>
        <p class="welcome-subtitle">Here's what's happening with your inventory
          today</p>
      </div>
    </div>
  </div>

  <!-- Navigation Cards - Quick Access to All Pages -->
  <div class="section-header">
    <h2 class="section-title">
      <i class="fas fa-compass"></i>
      Quick Navigation
    </h2>
  </div>

  <div class="nav-cards-grid">
    <a href="/inventory" class="nav-card">
      <div class="nav-card-icon blue">
        <i class="fas fa-boxes"></i>
      </div>
      <div class="nav-card-content">
        <h4>Inventory</h4>
        <p>Manage all computer hardware and peripherals</p>
      </div>
      <div class="nav-card-arrow">
        <i class="fas fa-chevron-right"></i>
      </div>
    </a>

    <a href="/transactions" class="nav-card">
      <div class="nav-card-icon green">
        <i class="fas fa-exchange-alt"></i>
      </div>
      <div class="nav-card-content">
        <h4>Check-In / Check-Out</h4>
        <p>Assign items to users or process returns</p>
      </div>
      <div class="nav-card-arrow">
        <i class="fas fa-chevron-right"></i>
      </div>
    </a>

    <a href="/history" class="nav-card">
      <div class="nav-card-icon purple">
        <i class="fas fa-history"></i>
      </div>
      <div class="nav-card-content">
        <h4>Asset History</h4>
        <p>View complete transaction audit trails</p>
      </div>
      <div class="nav-card-arrow">
        <i class="fas fa-chevron-right"></i>
      </div>
    </a>

    <a href="/reports" class="nav-card">
      <div class="nav-card-icon orange">
        <i class="fas fa-chart-bar"></i>
      </div>
      <div class="nav-card-content">
        <h4>Reports</h4>
        <p>Generate insights and analytics</p>
      </div>
      <div class="nav-card-arrow">
        <i class="fas fa-chevron-right"></i>
      </div>
    </a>

    {{! Always show admin cards for testing }}
    {{#if (isAdmin user)}}
      <a href="/users" class="nav-card admin-card">
        <div class="nav-card-icon red">
          <i class="fas fa-users-cog"></i>
        </div>
        <div class="nav-card-content">
          <h4>User Management</h4>
          <p>Create users, assign roles, manage access</p>
        </div>
        <div class="nav-card-arrow">
          <i class="fas fa-chevron-right"></i>
        </div>
      </a>

      <a href="/keys" class="nav-card admin-card">
        <div class="nav-card-icon yellow">
          <i class="fas fa-key"></i>
        </div>
        <div class="nav-card-content">
          <h4>API Keys</h4>
          <p>Generate and manage API access keys</p>
        </div>
        <div class="nav-card-arrow">
          <i class="fas fa-chevron-right"></i>
        </div>
      </a>
    {{/if}}
  </div>
</div>
