<div class="page-wrapper">
  <div class="page-header-modern">
    <div class="page-header-content">
      <div class="page-header-left">
        <span class="page-eyebrow">Assets</span>
        <h1 class="page-heading">Inventory Management</h1>
        <p class="page-description">Manage all computer hardware and peripherals in your organization</p>
      </div>
      <div class="page-header-right">
        <a href="/items/new" class="btn btn-primary">
          <i class="fas fa-plus"></i>
          Add Item
        </a>
      </div>
    </div>
  </div>

  <div class="data-card">
    <div class="data-card-header">
      <div class="data-card-header-left">
        <h3 class="data-card-title">
          <i class="fas fa-boxes"></i>
          All Items
        </h3>
      </div>
      <div class="data-card-header-right">
        <div class="search-input-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" id="inventorySearch" placeholder="Search items..." autocomplete="off">
          <button type="button" id="clearInventorySearch" class="hidden">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Item ID</th>
            <th>Serial Number</th>
            <th>Model</th>
            <th>Brand</th>
            <th>Category</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#if items.length}}
            {{#each items}}
              <tr>
                <td>{{this.itemId}}</td>
                <td>{{this.serialNumber}}</td>
                <td>{{this.model}}</td>
                <td>{{this.brand}}</td>
                <td>{{this.category}}</td>
                <td>
                  <span class="status-badge
                    {{#if (eq this.status "Available")}}status-available{{/if}}
                    {{#if (eq this.status "In-Use")}}status-inuse{{/if}}
                    {{#if (eq this.status "Maintenance")}}status-maintenance{{/if}}
                    {{#if (eq this.status "Retired")}}status-retired{{/if}}
                  ">
                    {{this.status}}
                  </span>
                </td>
                <td>
                  {{#if this.assignedTo}}
                    {{this.assignedTo.name}}
                  {{else}}
                    —
                  {{/if}}
                </td>
                <td>
                  <a href="/items/{{this._id}}" class="btn btn-outline btn-sm">View</a>
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="8" class="table-empty">
                <div class="empty-state">
                  <div class="empty-state-icon">
                    <i class="fas fa-boxes"></i>
                  </div>
                  <h4>No items found</h4>
                  <p>Inventory items will appear here once added</p>
                  <a href="/items/new" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Add First Item
                  </a>
                </div>
              </td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const params = new URLSearchParams(window.location.search);
  const success = params.get("success");

  if (success) {
    const message =
      success === "added"
        ? "Item added successfully"
        : success === "updated"
        ? "Item updated successfully"
        : success === "deleted"
        ? "Item deleted successfully"
        : "";

    if (message) {
      const popup = document.createElement("div");
      popup.textContent = message;
      popup.className = "success-toast";
      document.body.appendChild(popup);

      setTimeout(() => {
        popup.classList.add("show");
      }, 10);

      setTimeout(() => {
        popup.classList.remove("show");
        setTimeout(() => popup.remove(), 300);
      }, 2500);

      const url = new URL(window.location);
      url.searchParams.delete("success");
      window.history.replaceState({}, "", url);
    }
  }

  const inventorySearch = document.getElementById('inventorySearch');
  const clearInventorySearch = document.getElementById('clearInventorySearch');

  if (inventorySearch) {
    inventorySearch.addEventListener('input', function () {
      const term = this.value.toLowerCase();
      clearInventorySearch.classList.toggle('hidden', !term);
      document.querySelectorAll('.data-table tbody tr').forEach(function (row) {
        row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
      });
    });
  }

  if (clearInventorySearch) {
    clearInventorySearch.addEventListener('click', function () {
      inventorySearch.value = '';
      this.classList.add('hidden');
      document.querySelectorAll('.data-table tbody tr').forEach(function (row) {
        row.style.display = '';
      });
      inventorySearch.focus();
    });
  }
</script>