<div class="page-wrapper">
  <div class="page-header-modern">
    <div class="page-header-content">
      <div class="page-header-left">
        <span class="page-eyebrow">Assets</span>
        <h1 class="page-heading">Inventory Management</h1>
        <p class="page-description">Manage all computer hardware and peripherals in your organization</p>
      </div>
      <div class="page-header-right">
        <button class="btn btn-primary" onclick="alert('Add Item - To be implemented by Person 2')">
          <i class="fas fa-plus"></i>
          Add Item
        </button>
      </div>
    </div>
  </div>

  <div class="data-card">
    <div class="data-card-header">
      <div class="data-card-header-left">
        <h3 class="data-card-title">
          <i class="fas fa-boxes"></i>
          All Items
        </h3>
      </div>
      <div class="data-card-header-right">
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" placeholder="Search items...">
        </div>
        <button class="btn btn-outline btn-sm">
          <i class="fas fa-filter"></i>
          Filter
        </button>
      </div>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Item ID</th>
            <th>Serial Number</th>
            <th>Model</th>
            <th>Brand</th>
            <th>Category</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="8" class="table-empty">
              <div class="empty-state">
                <div class="empty-state-icon">
                  <i class="fas fa-boxes"></i>
                </div>
                <h4>No items found</h4>
                <p>Inventory items will appear here once added</p>
                <button class="btn btn-primary" onclick="alert('Add Item - To be implemented by Person 2')">
                  <i class="fas fa-plus"></i>
                  Add First Item
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>