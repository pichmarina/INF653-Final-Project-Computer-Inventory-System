<section class="card">
  <h1>Check In Item</h1>
  <p>Return an in-use item back to available status.</p>

  <form class="form" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="itemId">Item ID</label>
      <input type="text" id="itemId" name="itemId" placeholder="Enter item ID" />
    </div>

    <div class="form-group">
      <label for="notes">Notes</label>
      <input type="text" id="notes" name="notes" placeholder="Enter return notes" />
    </div>

    <div class="form-group">
      <label for="document">Return Inspection Document</label>
      <input type="file" id="document" name="document" />
    </div>

    <button type="submit" class="btn">Check In</button>
  </form>
</section>
