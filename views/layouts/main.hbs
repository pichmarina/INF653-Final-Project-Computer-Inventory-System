<!DOCTYPE html> 
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} | {{appName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
  .inv2-list-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 24px !important;
    padding: 28px 36px !important;
    border-bottom: 1px solid #e5e7eb !important;
    background: #ffffff !important;
  }

  .inv2-list-header-left {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
  }

  .inv2-list-header-title {
    margin: 0 !important;
    font-size: 2rem !important;
    line-height: 1.1 !important;
    font-weight: 800 !important;
    color: #111827 !important;
    white-space: nowrap !important;
  }

  .inv2-list-header-icon {
    width: 42px !important;
    height: 42px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #4f46e5 !important;
    font-size: 1.65rem !important;
  }

  .inv2-list-header-right {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 22px !important;
    flex: 1 !important;
  }

  .inv2-searchbar {
    box-sizing: border-box !important;
    width: 480px !important;
    height: 78px !important;
    padding: 0 24px !important;
    border: 1px solid #d1d5db !important;
    border-radius: 20px !important;
    background: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
  }

  .inv2-searchbar > i {
    font-size: 1.7rem !important;
    color: #6b7280 !important;
    flex-shrink: 0 !important;
  }

  .inv2-searchbar input#inventorySearch {
    appearance: none !important;
    -webkit-appearance: none !important;
    width: 100% !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    color: #111827 !important;
    font-size: 1.15rem !important;
  }

  .inv2-searchbar input#inventorySearch:focus {
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .inv2-search-clear {
    border: 0 !important;
    background: transparent !important;
    color: #111827 !important;
    font-size: 1rem !important;
    padding: 0 !important;
  }

  .inv2-search-clear.hidden {
    display: none !important;
  }

  .inv2-filter-trigger {
    min-width: 160px !important;
    height: 78px !important;
    padding: 0 24px !important;
    border: 1px solid #d1d5db !important;
    border-radius: 18px !important;
    background: #ffffff !important;
    color: #111827 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 16px !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
  }

  .inv2-filter-trigger-left {
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
  }
</style>
</head>
<body>
  {{#if user}}
    <div class="app-container">
      {{> sidebar}}
      <div class="main-content">
        {{> navbar}}
        <main class="page-content">
          <div class="container-fluid">
            {{{body}}}
          </div>
        </main>
        {{> footer}}
      </div>
    </div>
  {{else}}
    {{{body}}}
  {{/if}}

  <div class="modal" id="confirmModal" style="display: none;">
    <div class="modal-overlay" id="confirmModalOverlay"></div>
    <div class="modal-container modal-sm" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle">
      <div class="modal-header">
        <h3 class="modal-title" id="confirmModalTitle">
          <i class="fas fa-exclamation-circle"></i>
          Confirm Action
        </h3>
        <button class="modal-close" id="closeConfirmModal" type="button" aria-label="Close">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="modal-body">
        <p id="confirmModalMessage">Are you sure you want to continue?</p>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" id="cancelConfirmModal" type="button">Cancel</button>
        <button class="btn btn-danger" id="acceptConfirmModal" type="button">Confirm</button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>