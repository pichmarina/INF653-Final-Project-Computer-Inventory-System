<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} | {{appName}}</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  {{> navbar}}

  <main class="container">
    <section class="card page-header-card">
      <h1>{{title}}</h1>
      <p>Track item check-in, check-out, maintenance, and inventory movement history.</p>
    </section>

    <section class="card">
      <h2>Transaction History</h2>
      <p>Recent item movement and status activity.</p>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Item Name</th>
              <th>Asset Tag</th>
              <th>Action</th>
              <th>User</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {{#each historyRows}}
            <tr>
              <td>{{this.date}}</td>
              <td>{{this.itemName}}</td>
              <td>{{this.assetTag}}</td>
              <td><span class="status-badge">{{this.action}}</span></td>
              <td>{{this.user}}</td>
              <td>{{this.notes}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  {{> footer}}
</body>

</html>