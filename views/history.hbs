<div class="page-wrapper">
  <div class="page-header-modern">
    <div class="page-header-content">
      <div class="page-header-left">
        <span class="page-eyebrow">Audit</span>
        <h1 class="page-heading">Asset History</h1>
        <p class="page-description">View complete transaction history and audit trails for all items</p>
      </div>
    </div>
  </div>

  <div class="data-card">
    <div class="data-card-header">
      <div class="data-card-header-left">
        <h3 class="data-card-title">
          <i class="fas fa-history"></i>
          Transaction History
        </h3>
        {{#if hasHistory}}
          <span class="data-card-count">{{history.length}} records</span>
        {{/if}}
      </div>
      <div class="data-card-header-right">
        <div class="search-input-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" id="historySearch" placeholder="Search history..." autocomplete="off">
          <button type="button" id="clearHistorySearch" class="hidden">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="table-wrapper">
      <table class="data-table" id="historyTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Item</th>
            <th>Action</th>
            <th>User</th>
            <th>Notes</th>
            <th>Document</th>
          </tr>
        </thead>
        <tbody>
          {{#if hasHistory}}
            {{#each history}}
              <tr>
                <td>
                  <div>{{this.date}}</div>
                  <div class="text-muted" style="font-size:0.75rem;">{{this.time}}</div>
                </td>
                <td>
                  <div>{{this.itemName}}</div>
                  {{#if this.serialNumber}}
                    <div class="text-muted" style="font-size:0.75rem;">SN: {{this.serialNumber}}</div>
                  {{/if}}
                </td>
                <td>
                  <span class="badge {{this.actionClass}}">{{this.action}}</span>
                </td>
                <td>
                  <div>{{this.userName}}</div>
                  <div class="text-muted" style="font-size:0.75rem;">{{this.userEmail}}</div>
                </td>
                <td>{{#if this.notes}}{{this.notes}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
                <td>
                  {{#if this.documentUrl}}
                    <a href="{{this.documentUrl}}" target="_blank" class="btn btn-outline" style="font-size:0.75rem;padding:4px 10px;">
                      <i class="fas fa-file"></i> View
                    </a>
                  {{else}}
                    <span class="text-muted">—</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="6" class="table-empty">
                <div class="empty-state">
                  <div class="empty-state-icon">
                    <i class="fas fa-history"></i>
                  </div>
                  <h4>No history yet</h4>
                  <p>Transaction history will appear here once items are checked in or out</p>
                </div>
              </td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .search-box input::-webkit-search-cancel-button,
  .search-box input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; display: none !important; }
  .search-box input::-ms-clear { display: none; }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('historySearch');
    var table = document.getElementById('historyTable');
    var clearBtn = document.getElementById('clearHistorySearch');
    if (!searchInput || !table) return;
    searchInput.addEventListener('input', function() {
      var filter = this.value.toLowerCase();
      var rows = table.querySelectorAll('tbody tr');
      rows.forEach(function(row) {
        row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
      });
      if (clearBtn) { if (this.value.length > 0) { clearBtn.classList.remove('hidden'); } else { clearBtn.classList.add('hidden'); } }
    });
    if (clearBtn) clearBtn.addEventListener('click', function() {
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
      searchInput.focus();
    });
  });
</script>
