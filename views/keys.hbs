<section class="page-stack">
  <div class="section-heading">
    <div>
      <div class="eyebrow">Admin Workspace</div>
      <h1>API Key Management</h1>
      <p>
        Generate, review, and revoke service credentials for integrations that need access to the
        computer inventory system outside the browser UI.
      </p>
    </div>
    <span class="panel-chip">Admin Only</span>
  </div>

  {{#if successMessage}}
    <div class="alert alert-success">{{successMessage}}</div>
  {{/if}}

  {{#if errorMessage}}
    <div class="alert alert-error">{{errorMessage}}</div>
  {{/if}}

  {{#if rawKey}}
    <div class="alert alert-warning">
      <div style="flex:1;">
        <strong>Copy this key now. It will not be shown again.</strong>
        <span class="key-reveal">{{rawKey}}</span>
        <small class="usage-note">
          Header format: x-api-key: {{rawKey}}
        </small>
      </div>
    </div>
  {{/if}}

  <div class="metric-grid">
    <div class="metric-card">
      <span class="metric-label">Active Keys</span>
      <strong>{{keyCount}}</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Storage Method</span>
      <strong>SHA-256</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Reveal Policy</span>
      <strong>One Time</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Access Layer</span>
      <strong>x-api-key</strong>
    </div>
  </div>

  <div class="panel-grid">
    <div class="glass-card">
      <div class="panel-title-wrap">
        <h2>Create New API Key</h2>
        <span class="panel-chip">Integration access</span>
      </div>

      <p class="panel-description">
        Use API keys for non-browser clients and internal service integrations. The raw secret is generated once and only its hash is stored in the database.
      </p>

      <form action="/api/keys" method="POST" class="form">
        <div class="form-group">
          <label for="name">Key Label</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="e.g. Desktop Audit Service"
            autocomplete="off"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-block">Generate API Key</button>
      </form>

      <div class="info-block">
        <strong>Security flow</strong>
        <p>Generate raw key → hash before storage → validate incoming header by hashing again → revoke instantly when no longer trusted.</p>
      </div>
    </div>

    <div class="glass-card">
      <div class="panel-title-wrap">
        <h2>Active Keys</h2>
        <span class="panel-chip">{{keyCount}} active</span>
      </div>

      <p class="panel-description">
        Revoke any key immediately if an integration is retired, rotated, or suspected to be exposed.
      </p>

      <div class="key-list">
        {{#each keys}}
          <div class="key-card modern-key-card">
            <div class="key-header">
              <div>
                <span class="key-name">{{this.name}}</span>
                <div class="key-subline">Hash preview: {{this.shortHash}}••••••••</div>
              </div>
              <span class="badge badge-success">Active</span>
            </div>

            <div class="key-meta">
              <span class="key-meta-item">{{this.createdBy.name}}</span>
              <span class="key-meta-item">{{this.createdBy.email}}</span>
              <span class="key-meta-item">{{this.createdBy.role}}</span>
              <span class="key-meta-item">{{this.createdAtLabel}}</span>
            </div>

            <div class="key-footer">
              <form action="/api/keys/{{this._id}}?_method=DELETE" method="POST">
                <button
                  type="submit"
                  class="btn btn-danger btn-sm"
                  onclick="return confirm('Revoke this key? This action cannot be undone.')"
                >
                  Revoke Key
                </button>
              </form>
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <div class="empty-state-icon">🔐</div>
            <h3>No active API keys</h3>
            <p>Create a key when an external integration needs controlled access.</p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>