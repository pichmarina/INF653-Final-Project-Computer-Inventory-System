<section class="page-stack">
  <div class="page-header">
    <div>
      <div class="eyebrow">Admin Workspace</div>
      <h1>API Key Management</h1>
      <p>
        Generate, review, and revoke integration keys for programmatic access to the system.
      </p>
    </div>
    <span class="panel-chip">Admin Only</span>
  </div>

  {{#if successMessage}}
    <div class="alert alert-success">{{successMessage}}</div>
  {{/if}}

  {{#if errorMessage}}
    <div class="alert alert-error">{{errorMessage}}</div>
  {{/if}}

  {{#if rawKey}}
    <div class="alert alert-warning">
      <div style="flex:1;">
        <strong>Copy this key now. It will not be shown again.</strong>
        <span class="key-reveal">{{rawKey}}</span>
        <small class="usage-note">Header format: x-api-key: {{rawKey}}</small>
      </div>
    </div>
  {{/if}}

  <div class="metric-grid">
    <div class="metric-card">
      <span class="metric-label">Active Keys</span>
      <strong>{{keyCount}}</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Storage</span>
      <strong>SHA-256</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Reveal Policy</span>
      <strong>One Time</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Header</span>
      <strong>x-api-key</strong>
    </div>
  </div>

  <div class="admin-grid">
    <div class="surface-card">
      <div class="card-head">
        <div>
          <h2>Create New API Key</h2>
          <p>Generate secure keys for integrations and internal services.</p>
        </div>
        <span class="soft-badge">Integration access</span>
      </div>

      <form action="/api/keys" method="POST" class="form">
        <div class="form-group">
          <label for="name">Key Label</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="e.g. Desktop Audit Service"
            autocomplete="off"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-block">Generate API Key</button>
      </form>
    </div>

    <div class="surface-card">
      <div class="card-head">
        <div>
          <h2>Active Keys</h2>
          <p>Revoke any key immediately if an integration is retired or compromised.</p>
        </div>
        <span class="soft-badge">{{keyCount}} active</span>
      </div>

      <div class="entity-list">
        {{#each keys}}
          <div class="entity-card">
            <div class="entity-main">
              <div>
                <h3>{{this.name}}</h3>
                <p>Hash preview: {{this.shortHash}}••••••••</p>
              </div>

              <div class="entity-badges">
                <span class="badge badge-success">Active</span>
              </div>
            </div>

            <div class="entity-meta">
              <span class="meta-pill">{{this.createdBy.name}}</span>
              <span class="meta-pill">{{this.createdBy.email}}</span>
              <span class="meta-pill">{{this.createdBy.role}}</span>
              <span class="meta-pill">{{this.createdAtLabel}}</span>
            </div>

            <div class="entity-actions">
              <form action="/api/keys/{{this._id}}?_method=DELETE" method="POST">
                <button
                  type="submit"
                  class="btn btn-danger btn-sm"
                  onclick="return confirm('Revoke this key? This action cannot be undone.')"
                >
                  Revoke Key
                </button>
              </form>
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <h3>No active API keys</h3>
            <p>Create a key when an external integration needs controlled access.</p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>