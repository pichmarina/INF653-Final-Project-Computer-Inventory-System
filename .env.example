PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
DEV_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
STORAGE_PROVIDER=r2

# Cloudflare R2 settings (required when STORAGE_PROVIDER=r2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
